class Solution {
    public int[][] flipAndInvertImage(int[][] image) {
        int n = image.length;

        for (int[] row : image) {
            int left = 0;
            int right = n - 1;

            while (left <= right) {
                // If elements are identical, both must flip
                if (row[left] == row[right]) {
                    int flipped = row[left] ^ 1;
                    row[left] = flipped;
                    row[right] = flipped;
                }
                // If they are different (e.g., 0 and 1), swapping then inverting
                // produces the same values, so we do nothing.
                left++;
                right--;
            }
        }

        return image;
    }
}
